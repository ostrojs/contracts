{
    "name": "@ostro/contracts",
    "version": "2.0.0-alpha.4",
    "description": "Contracts module for OstroJS",
    "exports": {
        "./*": {
            "types": [
                "./.typed/*.d.ts",
                "./.typed/*/index.d.ts"
            ],
            "default": [
                "./*.js",
                "./*/index.js"
            ]
        }
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf build && ostro-build --prepare",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "contracts"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/contracts.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/contracts/issues"
    },
    "homepage": "https://github.com/ostrojs/contracts#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
